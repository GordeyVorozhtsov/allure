# Скопируйте в .env и при необходимости меняйте:
#   cp .env.example .env
# .env не попадает в git (см. .gitignore), в репозитории лежит только этот шаблон.
#
# Значения ниже — рабочие dev-дефолты, совместимые с deploy/keycloak/allure-realm.json
# и дефолтами бэкенда (admin/admin, allure-dev-secret, dev-only-secret).
# На БОЕВОМ стенде обязательно замените SECRET_KEY, SESSION_SECRET, KEYCLOAK_SECRET,
# ADMIN_PASSWORD и KC_BOOTSTRAP_ADMIN_PASSWORD на свои.

# ── Backend allure-hub ────────────────────────────────────────────────
# Каталог данных внутри контейнера (том allure3-data монтируется в /data).
DATA_DIR=/data
# Учётка администратора для локального входа (POST /login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Секреты сессий — задайте свои для боевого стенда.
SECRET_KEY=dev-only-secret
SESSION_SECRET=dev-only-secret
# Сколько последних отчётов хранить и лимиты загрузки/распаковки (МБ).
KEEP_REPORTS=20
MAX_UPLOAD_MB=100
MAX_UNPACKED_MB=500

# Keycloak (идентификация). При смене BASE_URL обновите ISSUER и redirectUris в realm.
# Внешний адрес Keycloak — по HTTPS (порт 8443) для админ-консоли и входа.
KEYCLOAK_ISSUER=https://127.0.0.1:8443/realms/allure
# Внутренний обмен кода на токен — по HTTP внутри docker-сети (self-signed не валидируется).
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/allure
KEYCLOAK_CLIENT=allure
# Должен совпадать с client-secret "allure" в deploy/keycloak/allure-realm.json.
KEYCLOAK_SECRET=allure-dev-secret
BASE_URL=http://127.0.0.1:8090

# ── Keycloak (сервис) ────────────────────────────────────────────────
# Администратор контейнера Keycloak (консоль /admin).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Внешний адрес Keycloak; при смене BASE_URL обновите и его (по HTTPS в dev).
KC_HOSTNAME=https://127.0.0.1:8443